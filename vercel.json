{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt && cd site && npm ci",
  "buildCommand": "cd site && PATH=$(pwd)/../.venv/bin:$PATH npm run build",
  "outputDirectory": "site/dist",
  "framework": null,
  "env": {
    "PUBLIC_BASE_PATH": "/",
    "PUBLIC_SITE_URL": "https://salem-study-system.vercel.app"
  },
  "headers": [
    {
      "source": "/pagefind/:path*.pagefind",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "wasm" }
      ]
    },
    {
      "source": "/pagefind/:path*.pf_meta",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "meta" }
      ]
    },
    {
      "source": "/pagefind/:path*.pf_index",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "index" }
      ]
    },
    {
      "source": "/pagefind/:path*.pf_fragment",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "fragment" }
      ]
    },
    {
      "source": "/pagefind-:version/:path*.pagefind",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "wasm" }
      ]
    },
    {
      "source": "/pagefind-:version/:path*.pf_meta",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "meta" }
      ]
    },
    {
      "source": "/pagefind-:version/:path*.pf_index",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "index" }
      ]
    },
    {
      "source": "/pagefind-:version/:path*.pf_fragment",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=3600, no-transform" },
        { "key": "X-Pagefind-Asset", "value": "fragment" }
      ]
    }
  ]
}
