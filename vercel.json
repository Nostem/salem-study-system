{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python3 -m pip install --user -r requirements-dev.txt && cd site && npm ci",
  "buildCommand": "cd site && npm run build",
  "outputDirectory": "site/dist",
  "framework": null,
  "env": {
    "PUBLIC_BASE_PATH": "/",
    "PUBLIC_SITE_URL": "https://salem-study-system.vercel.app"
  }
}
