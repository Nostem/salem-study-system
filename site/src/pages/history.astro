---
import StudyLayout from '../layouts/StudyLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const historyPath = `${base}history/`;
const loginHref = `${base}login/?next=${encodeURIComponent(historyPath)}`;
---

<StudyLayout title="My Progress" active="progress">
  <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:py-10">
    <section class="space-y-6 text-text-body">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-accent-teal">Quiz history</p>
      <h1 class="mt-2 text-3xl font-semibold text-text-primary">My Progress</h1>
      <p class="mt-2 max-w-3xl text-sm text-text-muted">
        Review completed quizzes, pass/fail trend, weak topics, and prior question-by-question results.
      </p>
    </div>

    <div data-testid="history-login-required" class="rounded-xl border border-border bg-bg-card p-6">
      <h2 class="text-xl font-semibold text-text-primary">Log in to view your progress</h2>
      <p class="mt-2 text-sm text-text-muted">
        Quiz history is private and only shows attempts for your account.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a href={loginHref} class="study-button study-button--accent">Log in</a>
        <span class="text-xs text-text-muted">Need access? Use the <button type="button" class="contact-inline-link" data-open-contact>Contact / Feedback form</button> and ask the site administrator for a Salem Study beta account.</span>
      </div>
    </div>

    <div data-testid="history-app" class="hidden space-y-6">
      <div data-testid="history-summary" class="grid gap-3 md:grid-cols-4">
        <div class="rounded-xl border border-border bg-bg-card p-4">
          <div class="text-xs uppercase tracking-[0.18em] text-text-muted">Completed</div>
          <div data-history-summary="completed" class="mt-2 font-mono text-3xl font-semibold text-text-primary">0</div>
        </div>
        <div class="rounded-xl border border-border bg-bg-card p-4">
          <div class="text-xs uppercase tracking-[0.18em] text-text-muted">Avg score</div>
          <div data-history-summary="average" class="mt-2 font-mono text-3xl font-semibold text-text-primary">0%</div>
        </div>
        <div class="rounded-xl border border-border bg-bg-card p-4">
          <div class="text-xs uppercase tracking-[0.18em] text-text-muted">Pass rate</div>
          <div data-history-summary="pass-rate" class="mt-2 font-mono text-3xl font-semibold text-text-primary">0%</div>
        </div>
        <div class="rounded-xl border border-border bg-bg-card p-4">
          <div class="text-xs uppercase tracking-[0.18em] text-text-muted">Last quiz</div>
          <div data-history-summary="last" class="mt-2 font-mono text-lg font-semibold text-text-primary">—</div>
        </div>
      </div>

      <section data-testid="history-personal-analytics" class="rounded-xl border border-border bg-bg-card p-4">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <h2 class="text-lg font-semibold text-text-primary">Personal study dashboard</h2>
            <p class="mt-1 text-xs text-text-muted">Accuracy, due review load, and mastery state from saved quiz attempts.</p>
          </div>
          <a href={`${base}quiz-v2/review/`} class="study-button study-button--accent text-xs">Open due review</a>
        </div>
        <dl class="mt-4 grid gap-3 sm:grid-cols-4">
          <div class="rounded-lg border border-border bg-bg p-3">
            <dt class="text-xs uppercase tracking-[0.16em] text-text-muted">Overall accuracy</dt>
            <dd data-history-analytics="accuracy" class="mt-2 text-2xl font-semibold text-text-primary">—</dd>
          </div>
          <div class="rounded-lg border border-border bg-bg p-3">
            <dt class="text-xs uppercase tracking-[0.16em] text-text-muted">Due reviews</dt>
            <dd data-history-analytics="due" class="mt-2 text-2xl font-semibold text-accent-amber">0</dd>
          </div>
          <div class="rounded-lg border border-border bg-bg p-3">
            <dt class="text-xs uppercase tracking-[0.16em] text-text-muted">Shaky</dt>
            <dd data-history-analytics="shaky" class="mt-2 text-2xl font-semibold text-mastery-weak">0</dd>
          </div>
          <div class="rounded-lg border border-border bg-bg p-3">
            <dt class="text-xs uppercase tracking-[0.16em] text-text-muted">Mastered</dt>
            <dd data-history-analytics="mastered" class="mt-2 text-2xl font-semibold text-mastery-ok">0</dd>
          </div>
        </dl>
      </section>

      <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
        <section class="rounded-xl border border-border bg-bg-card p-4">
          <div class="mb-3 flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-text-primary">Completed quizzes</h2>
            <span data-history-last-completed class="font-mono text-[11px] text-text-muted"></span>
          </div>
          <div data-testid="history-sessions" class="overflow-x-auto">
            <table class="w-full min-w-[720px] border-collapse text-sm">
              <thead class="text-left text-xs uppercase tracking-[0.16em] text-text-muted">
                <tr class="border-b border-border">
                  <th class="py-2 pr-3">Date</th>
                  <th class="py-2 pr-3">Quiz</th>
                  <th class="py-2 pr-3">Mode</th>
                  <th class="py-2 pr-3">Score</th>
                  <th class="py-2 pr-3">Review</th>
                </tr>
              </thead>
              <tbody data-history-sessions-body></tbody>
            </table>
          </div>
          <div data-history-empty class="hidden rounded-lg border border-border bg-bg p-5 text-sm text-text-body">
            <div class="study-kicker">No attempts yet</div>
            <p class="mt-2 text-text-muted">Complete a Quick Quiz or Practice set while logged in. Scores, missed topics, and due review items will appear here.</p>
            <a href={`${base}quiz/`} class="study-button study-button--primary mt-4">Start Quick Quiz</a>
          </div>
        </section>

        <aside data-testid="history-weak-topics" class="rounded-xl border border-border bg-bg-card p-4">
          <h2 class="text-lg font-semibold text-text-primary">Weak topics</h2>
          <p class="mt-1 text-xs text-text-muted">Topics with recent misses, sorted by miss count.</p>
          <div data-history-weak-topics-list class="mt-4 space-y-3"></div>
        </aside>
      </div>

      <section data-testid="history-review" class="rounded-xl border border-border bg-bg-card p-4">
        <h2 class="text-lg font-semibold text-text-primary">Session review</h2>
        <p data-history-review-empty class="mt-2 text-sm text-text-muted">Select a completed quiz to review question-level results, source links, and missed items.</p>
        <div data-history-review-content class="mt-4 space-y-3"></div>
      </section>
    </div>
    </section>
  </main>

  <script>
    import { getQuizHistory, hasSupabaseConfig, type QuizHistoryResponse, type QuizHistorySession } from '../utils/auth-client';

    const loginPanel = document.querySelector<HTMLElement>('[data-testid="history-login-required"]');
    const app = document.querySelector<HTMLElement>('[data-testid="history-app"]');
    const sessionsBody = document.querySelector<HTMLElement>('[data-history-sessions-body]');
    const emptyState = document.querySelector<HTMLElement>('[data-history-empty]');
    const reviewEmpty = document.querySelector<HTMLElement>('[data-history-review-empty]');
    const reviewContent = document.querySelector<HTMLElement>('[data-history-review-content]');
    const weakTopicsList = document.querySelector<HTMLElement>('[data-history-weak-topics-list]');
    const appBase = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

    function formatPercent(value: number): string {
      return `${Math.round((Number(value) || 0) * 100)}%`;
    }

    function escapeHtml(value: unknown): string {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] ?? char));
    }

    function formatDate(value: string | null): string {
      if (!value) return '—';
      return new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(value));
    }

    function normalizeAppHref(href: string | null | undefined): string | null {
      if (!href) return null;
      if (/^https?:\/\//i.test(href)) return href;
      if (href.startsWith(appBase)) return href;
      if (href.startsWith('/')) return `${appBase.replace(/\/$/, '')}${href}`;
      return `${appBase}${href.replace(/^\/+/, '')}`;
    }

    function renderSummary(data: QuizHistoryResponse): void {
      document.querySelector<HTMLElement>('[data-history-summary="completed"]')!.textContent = String(data.summary.completedQuizzes);
      document.querySelector<HTMLElement>('[data-history-summary="average"]')!.textContent = formatPercent(data.summary.averageScore);
      document.querySelector<HTMLElement>('[data-history-summary="pass-rate"]')!.textContent = formatPercent(data.summary.passRate);
      document.querySelector<HTMLElement>('[data-history-summary="last"]')!.textContent = data.summary.lastCompletedAt ? formatDate(data.summary.lastCompletedAt) : '—';
      document.querySelector<HTMLElement>('[data-history-analytics="accuracy"]')!.textContent = data.summary.overallAccuracy == null ? '—' : formatPercent(data.summary.overallAccuracy);
      document.querySelector<HTMLElement>('[data-history-analytics="due"]')!.textContent = String(data.summary.dueReviewCount ?? 0);
      document.querySelector<HTMLElement>('[data-history-analytics="shaky"]')!.textContent = String(data.summary.shakyCount ?? 0);
      document.querySelector<HTMLElement>('[data-history-analytics="mastered"]')!.textContent = String(data.summary.masteredCount ?? 0);
      const last = document.querySelector<HTMLElement>('[data-history-last-completed]');
      if (last) last.textContent = data.summary.lastCompletedAt ? `Last: ${formatDate(data.summary.lastCompletedAt)}` : '';
    }

    function scoreLine(session: QuizHistorySession): string {
      const percentage = Math.round((Number(session.score) || 0) * 100);
      return `Score: ${session.correctCount}/${session.answeredCount} (${percentage}%) · ${session.passStatus.toUpperCase()}`;
    }

    function modeBadge(session: QuizHistorySession): string {
      const source = String(session.source ?? '').toLowerCase();
      const type = String(session.quizType ?? '').toLowerCase();
      if (source === 'quiz' || type === 'classic') return 'Classic';
      if (type === 'graph') return 'Graph';
      if (type === 'review' || source.includes('review')) return 'Review';
      if (source === 'quiz-v2') return 'Study Builder';
      return session.quizType || 'Quiz';
    }

    function renderSessions(sessions: QuizHistorySession[]): void {
      if (!sessionsBody || !emptyState) return;
      if (sessions.length === 0) {
        emptyState.classList.remove('hidden');
        sessionsBody.innerHTML = '';
        return;
      }
      emptyState.classList.add('hidden');
      sessionsBody.innerHTML = sessions.map((session) => {
        const replayHref = normalizeAppHref(session.replayHref);
        const reviewMissedHref = normalizeAppHref(session.reviewMissedHref);
        const retakeMissedHref = normalizeAppHref(session.retakeMissedHref);
        const badge = modeBadge(session);
        return `
        <tr class="border-b border-border text-text-body">
          <td class="py-3 pr-3 align-top text-xs text-text-muted">${escapeHtml(formatDate(session.completedAt))}</td>
          <td class="py-3 pr-3 align-top">
            <div class="font-medium text-text-primary">${escapeHtml(session.filterSummary)}</div>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-text-muted">
              <span class="rounded-full border border-accent-blue px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-accent-blue">${escapeHtml(badge)}</span>
              <span>${escapeHtml(session.quizType)} · ${session.totalQuestions} total</span>
            </div>
          </td>
          <td class="py-3 pr-3 align-top text-xs text-text-muted">${escapeHtml(session.feedbackMode)}${session.completionMode === 'early' ? ' · Early finish' : ''}</td>
          <td class="py-3 pr-3 align-top font-mono text-xs ${session.passStatus === 'pass' ? 'text-mastery-ok' : 'text-mastery-weak'}">${escapeHtml(scoreLine(session))}</td>
          <td class="py-3 pr-3 align-top"><div class="flex flex-wrap gap-2"><button type="button" data-review-session="${escapeHtml(session.id)}" aria-label="Review ${escapeHtml(session.id)}" class="study-button study-button--accent text-xs">Review</button>${replayHref ? `<a href="${escapeHtml(replayHref)}" class="study-button study-button--secondary text-xs">Replay</a>` : ''}${reviewMissedHref ? `<a href="${escapeHtml(reviewMissedHref)}" class="study-button study-button--secondary text-xs !border-mastery-weak !text-mastery-weak">Review missed</a>` : ''}${retakeMissedHref ? `<a href="${escapeHtml(retakeMissedHref)}" class="study-button study-button--secondary text-xs !border-mastery-weak !text-mastery-weak">Quiz missed</a>` : ''}</div></td>
        </tr>
      `;
      }).join('');
    }

    function renderWeakTopics(data: QuizHistoryResponse): void {
      if (!weakTopicsList) return;
      if (data.weakTopics.length === 0) {
        weakTopicsList.innerHTML = '<div class="rounded-lg border border-border bg-bg p-4 text-sm text-text-body"><div class="study-kicker">No weak topics yet</div><p class="mt-2 text-text-muted">Missed questions will appear here after you complete saved quizzes.</p></div>';
        return;
      }
      weakTopicsList.innerHTML = data.weakTopics.map((topic) => `
        <div class="rounded-lg border border-border bg-bg p-3">
          <div class="flex items-center justify-between gap-3">
            <div class="font-medium text-text-primary">${escapeHtml(topic.title)}</div>
            <div class="font-mono text-xs text-mastery-weak">${formatPercent(topic.accuracy)}</div>
          </div>
          <div class="mt-1 text-xs text-text-muted">${topic.misses} miss${topic.misses === 1 ? '' : 'es'} / ${topic.attempts} attempts</div>
          <a href="${appBase}quiz-v2/play/?topics=${encodeURIComponent(topic.slug)}&count=10&seed=weak-topic" class="study-button study-button--secondary mt-2 text-xs">Practice topic</a>
        </div>
      `).join('');
    }

    function renderReview(session: QuizHistorySession): void {
      if (!reviewEmpty || !reviewContent) return;
      const replayHref = normalizeAppHref(session.replayHref);
      const reviewMissedHref = normalizeAppHref(session.reviewMissedHref);
      const retakeMissedHref = normalizeAppHref(session.retakeMissedHref);
      reviewEmpty.classList.add('hidden');
      reviewContent.innerHTML = `
        <div class="rounded-lg border border-border bg-bg p-3">
          <div class="font-mono text-xs ${session.passStatus === 'pass' ? 'text-mastery-ok' : 'text-mastery-weak'}">${escapeHtml(scoreLine(session))}</div>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-text-muted">
            <span class="rounded-full border border-accent-blue px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-accent-blue">${escapeHtml(modeBadge(session))}</span>
            <span>${escapeHtml(session.filterSummary)}</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          ${replayHref ? `<a href="${escapeHtml(replayHref)}" class="study-button study-button--accent text-xs">Replay full session</a>` : ''}
          ${reviewMissedHref ? `<a href="${escapeHtml(reviewMissedHref)}" class="study-button study-button--secondary text-xs !border-mastery-weak !text-mastery-weak">Review missed/unanswered</a>` : ''}
          ${retakeMissedHref ? `<a href="${escapeHtml(retakeMissedHref)}" class="study-button study-button--secondary text-xs !border-mastery-weak !text-mastery-weak">Quiz missed/unanswered</a>` : ''}
        </div>
        ${session.questions.map((question) => `
          <div class="rounded-lg border border-border bg-bg p-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-semibold text-text-primary">${question.position}. ${escapeHtml(question.displayTitle)}</h3>
              <div class="flex flex-wrap gap-2">
                ${question.sourceStatus && question.sourceStatus !== 'active' ? `<span class="rounded-full border border-accent-amber px-2 py-0.5 text-[11px] uppercase text-accent-amber">${escapeHtml(question.sourceStatus)}</span>` : ''}
                <span class="rounded-full border px-2 py-0.5 text-[11px] uppercase ${question.status === 'correct' ? 'border-mastery-ok text-mastery-ok' : question.status === 'incorrect' ? 'border-mastery-weak text-mastery-weak' : 'border-border-hi text-text-body'}">${escapeHtml(question.status === 'correct' ? 'Correct' : question.status)}</span>
              </div>
            </div>
            <div class="mt-2 text-sm text-text-body">Selected: ${escapeHtml(question.selectedLabel ?? '—')}${question.selectedOriginalLabel ? ` · Original: ${escapeHtml(question.selectedOriginalLabel)}` : ''}</div>
            <div class="mt-1 text-xs text-text-muted">Accepted: ${escapeHtml((question.acceptedDisplayLabels?.length ? question.acceptedDisplayLabels : question.acceptedLabels).join(', ') || '—')}${question.acceptedDisplayLabels?.length && question.acceptedLabels.join(', ') !== question.acceptedDisplayLabels.join(', ') ? ` · Original: ${escapeHtml(question.acceptedLabels.join(', '))}` : ''}</div>
            ${question.explanationText ? `<p class="mt-3 text-sm text-text-muted">${escapeHtml(question.explanationText)}</p>` : ''}
          </div>
        `).join('')}
      `;
    }

    async function initHistory(): Promise<void> {
      if (!hasSupabaseConfig()) return;
      try {
        const data = await getQuizHistory();
        loginPanel?.classList.add('hidden');
        app?.classList.remove('hidden');
        renderSummary(data);
        renderSessions(data.sessions);
        renderWeakTopics(data);
        sessionsBody?.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          const button = target.closest<HTMLButtonElement>('[data-review-session]');
          if (!button) return;
          const session = data.sessions.find((candidate) => candidate.id === button.dataset.reviewSession);
          if (session) {
            renderReview(session);
            document.querySelector<HTMLElement>('[data-testid="history-review"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      } catch (error) {
        loginPanel?.classList.remove('hidden');
        app?.classList.add('hidden');
      }
    }

    void initHistory();
  </script>
</StudyLayout>
