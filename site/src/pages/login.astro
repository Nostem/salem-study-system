---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Login">
  <main id="main-content" class="min-h-[calc(100vh-7rem)] px-6 py-12 text-text-body">
    <section class="mx-auto max-w-xl rounded-2xl border border-border bg-bg-surface p-8 shadow-2xl">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.22em] text-accent-amber">Salem Study beta</p>
      <h1 class="mb-3 text-3xl font-semibold text-text-primary">Log in</h1>
      <p class="mb-8 text-sm leading-6 text-text-muted">
        Log in to save quiz results, reopen missed questions, and keep My Progress current.
      </p>

      <div id="configWarning" class="mb-5 hidden rounded-lg border border-accent-amber bg-bg-card p-3 text-sm text-accent-amber">
        Login is not connected in this build yet. Study browsing still works; saved progress needs the deployed beta environment.
      </div>

      <form id="loginForm" class="space-y-5">
        <label class="block text-sm font-medium text-text-body">
          Username
          <input name="username" autocomplete="username" required class="mt-2 w-full rounded-lg border border-border bg-bg-card px-4 py-3 text-text-primary outline-none focus:border-accent-blue" placeholder="operator_one" />
        </label>

        <label class="block text-sm font-medium text-text-body">
          Password
          <input name="password" type="password" autocomplete="current-password" required class="mt-2 w-full rounded-lg border border-border bg-bg-card px-4 py-3 text-text-primary outline-none focus:border-accent-blue" placeholder="Your password" />
        </label>

        <button class="study-button study-button--primary w-full" type="submit">
          Log in
        </button>
      </form>

      <p id="loginStatus" class="mt-5 min-h-6 text-sm text-text-muted" role="status"></p>

      <p class="mt-8 border-t border-border pt-5 text-sm text-text-muted">
        Need access? Use the <button type="button" class="contact-inline-link" data-open-contact>Contact / Feedback form</button> and ask the site administrator for a Salem Study beta account.
      </p>
    </section>
  </main>

  <script>
    import { hasSupabaseConfig, loginWithUsername } from '../utils/auth-client';

    const form = document.querySelector<HTMLFormElement>('#loginForm');
    const status = document.querySelector<HTMLElement>('#loginStatus');
    const warning = document.querySelector<HTMLElement>('#configWarning');

    if (!hasSupabaseConfig()) {
      warning?.classList.remove('hidden');
    }

    const messages: Record<string, string> = {
      invalid_login: 'Username or password is incorrect.',
      username_and_password_required: 'Enter both username and password.',
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;

      const data = new FormData(form);
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submit?.setAttribute('disabled', 'true');
      status.textContent = 'Logging in…';
      status.className = 'mt-5 min-h-6 text-sm text-text-muted';

      const rawNext = new URLSearchParams(window.location.search).get('next');
      const defaultRedirect = `${window.location.origin}${window.location.pathname.replace(/login\/?$/, 'quiz')}`;
      let redirectTo = defaultRedirect;
      if (rawNext) {
        try {
          const candidate = new URL(rawNext, window.location.origin);
          const appBase = new URL(window.location.pathname.replace(/login\/?$/, ''), window.location.origin).pathname;
          if (candidate.origin === window.location.origin && candidate.pathname.startsWith(appBase)) {
            redirectTo = candidate.toString();
          }
        } catch {
          redirectTo = defaultRedirect;
        }
      }

      try {
        const result = await loginWithUsername({
          username: String(data.get('username') ?? ''),
          password: String(data.get('password') ?? ''),
        });
        localStorage.setItem('salem-study-user', JSON.stringify({
          username: result.user.username,
          displayName: result.user.display_name || result.user.username,
        }));
        status.textContent = `Logged in as ${result.user.display_name || result.user.username}. Redirecting…`;
        status.className = 'mt-5 min-h-6 text-sm text-accent-green';
        window.location.href = redirectTo;
      } catch (error) {
        const key = error instanceof Error ? error.message : 'request_failed';
        status.textContent = messages[key] ?? 'Login failed. Check your connection and try again.';
        status.className = 'mt-5 min-h-6 text-sm text-mastery-weak';
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  </script>
</BaseLayout>
