---
import StudyLayout from '../../layouts/StudyLayout.astro';
import QuestionBlockRenderer from '../../components/QuestionBlockRenderer.astro';
import { safeInlineJson } from '../../utils/safe-json';
import {
  getStructuredQuestions,
  questionDisplayLabel,
} from '../../utils/structured-quiz-data';
import { sourceRefHref, sourceRefLabel } from '../../utils/source-ref-links';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const questions = getStructuredQuestions();

const sessionMeta = questions.map((q) => ({
  slug: q.slug,
  examYear: q.examYear,
  track: q.track ?? '',
  status: q.status,
  quizEligible: q.quizEligible,
  requiresReference: q.requiresReference,
  title: q.title,
  topics: q.topics,
}));

---

<StudyLayout title="Practice" active="quick">
  <main class="max-w-[860px] mx-auto px-4 sm:px-6 py-6 lg:py-10 flex flex-col">
    <header class="border-b border-border pb-5 mb-5">
      <a href={`${base}study/`} class="text-[11px] font-mono text-text-muted no-underline hover:text-accent-blue">&lsaquo; Study</a>
      <div class="mt-2">
        <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-blue mb-1">Practice · preview works without login</div>
        <h1 class="font-serif text-3xl sm:text-4xl text-text-primary leading-tight">Practice</h1>
        <p class="text-sm text-text-muted max-w-2xl mt-1">
          Answer one question at a time, check the feedback, then move forward. Log in when you want this practice saved to My Progress.
        </p>
      </div>
    </header>

    <section
      data-testid="qv2p-session"
      class="order-2 mt-5 bg-bg-card border border-border rounded-lg p-4"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-blue">Current set</div>
          <div class="mt-1 text-sm text-text-primary" data-testid="qv2p-session-summary">Session summary loading…</div>
          <div class="mt-1 text-[12px] font-mono text-text-muted">
            Question <span data-testid="qv2p-session-index">0</span> / <span data-testid="qv2p-session-count">0</span>
            <span class="mx-1">·</span>
            <span data-testid="qv2p-session-total">0</span> match filters
          </div>
        </div>
        <a
          href={`${base}quiz-v2/`}
          data-testid="qv2p-adjust-set"
          class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
        >Adjust set</a>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-testid="qv2p-prev"
          class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
          disabled
        >&lsaquo; Prev</button>
        <button
          type="button"
          data-testid="qv2p-next"
          class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
          disabled
        >Next &rsaquo;</button>
        <button
          type="button"
          data-testid="qv2p-finish"
          class="study-button study-button--accent font-mono text-[11px] uppercase tracking-wider"
          disabled
        >Finish</button>
      </div>
      <details class="mt-3 text-[11px] font-mono text-text-muted" data-testid="qv2p-session-debug-toggle">
        <summary class="cursor-pointer underline hover:text-text-primary">Session details</summary>
        <dl class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-1 text-[12px] font-mono">
          <dt class="text-text-muted">Session ID</dt>
          <dd class="text-text-primary col-span-3 break-all" data-testid="qv2p-session-id">—</dd>
          <dt class="text-text-muted">Seed</dt>
          <dd class="text-text-primary" data-testid="qv2p-session-seed">—</dd>
          <dt class="text-text-muted">Save status</dt>
          <dd class="text-text-primary col-span-3" data-testid="qv2p-session-source">Preview locally</dd>
        </dl>
        <div class="mt-2 text-[11px] font-mono text-text-muted" data-testid="qv2p-session-debug">
          <code class="block break-all rounded border border-border bg-bg px-2 py-1" data-testid="qv2p-session-filters">{}</code>
        </div>
        <div class="mt-2 flex flex-wrap gap-2">
          <button
            type="button"
            data-testid="qv2p-create-backend-session"
            class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
          >Retry saving</button>
          <button
            type="button"
            data-testid="qv2p-submit-results"
            class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
            disabled
          >Submit progress</button>
        </div>
        <div data-testid="qv2p-submit-status" class="mt-2 text-xs text-text-muted">Preview locally, or log in to save progress.</div>
      </details>
    </section>

    <script type="application/json" id="qv2p-session-meta" set:html={safeInlineJson(sessionMeta)} />

    <article class="order-1 bg-bg-card border border-border rounded-lg p-4 sm:p-6 min-h-[400px]">
      <div id="qv2p-empty" data-testid="qv2p-empty" class="rounded-lg border border-border bg-bg p-4 text-sm text-text-muted">
        Loading session and selecting the first practice question…
      </div>

      <div id="qv2p-no-results" data-testid="qv2p-no-results" class="hidden rounded-lg border border-accent-amber bg-bg p-4 text-sm text-text-body">
        <div class="mb-1 font-mono text-[11px] uppercase tracking-wider text-accent-amber">No matching questions</div>
        <p class="text-text-muted">
          No questions match this set. Remove a filter or return to the builder and broaden the year, track, or topic selection.
        </p>
      </div>

      <section id="qv2p-results" data-testid="qv2p-results" class="hidden text-sm text-text-body">
        <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-blue mb-1">Results</div>
        <h2 class="font-serif text-2xl text-text-primary leading-tight">Practice complete</h2>
        <p class="mt-2 text-text-muted" data-testid="qv2p-results-score">Score loading…</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button
            type="button"
            data-testid="qv2p-results-review"
            class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
          >Review questions</button>
          <a
            href={`${base}quiz-v2/play/`}
            data-testid="qv2p-practice-again"
            class="study-button study-button--accent font-mono text-[11px] uppercase tracking-wider"
          >Practice again</a>
          <a
            href={`${base}quiz-v2/`}
            data-testid="qv2p-build-new-set"
            class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
          >Build a new set</a>
          <a
            href={`${base}history/`}
            data-testid="qv2p-my-progress"
            class="study-button study-button--secondary font-mono text-[11px] uppercase tracking-wider"
          >My Progress</a>
        </div>
      </section>

      {questions.map((q) => (
        <section
          class="qv2p-detail hidden"
          data-qv2p-detail={q.slug}
          data-testid={`qv2p-detail-${q.slug}`}
          data-correct-label={q.officialAnswerLabel}
        >
          <header class="border-b border-border pb-3 mb-4">
            <div class="font-mono text-[10px] uppercase tracking-wider text-accent-blue">
              {questionDisplayLabel(q)} · {q.examType} · {q.status}
              {q.requiresReference && <span> · ref required</span>}
            </div>
            <h2 class="font-serif text-2xl text-text-primary leading-tight mt-1">{q.title}</h2>
            <div class="text-[11px] font-mono text-text-muted mt-1">
              slug: <code>{q.slug}</code>
              <span class="mx-2">·</span>
              <a
                href={`${base}quiz-v2/?slug=${q.slug}`}
                class="underline hover:text-accent-blue"
                data-testid="qv2p-source-link"
              >view in preview</a>
            </div>
          </header>

          <section class="qv2p-section">
            <h3 class="qv2p-section-title">Stem</h3>
            <div class="qv2p-blocks" data-testid="qv2p-stem-blocks">
              {q.stemBlocks.map((b) => <QuestionBlockRenderer block={b} />)}
            </div>
          </section>

          <section class="qv2p-section">
            <h3 class="qv2p-section-title">Choices</h3>
            <p class="text-xs text-text-muted mb-3">Select one answer to reveal feedback, then use Next to keep studying.</p>
            <ol class="space-y-2" data-testid="qv2p-choices">
              {q.choices.map((c) => (
                <li>
                  <button
                    type="button"
                    class="qv2p-choice w-full text-left border border-border rounded p-3 hover:bg-bg focus:bg-bg focus:outline-none focus:border-accent-blue"
                    data-choice-label={c.label}
                    data-correct={c.isCorrect ? 'true' : 'false'}
                    data-testid={`qv2p-choice-${c.label}`}
                  >
                    <div class="font-mono text-[11px] uppercase tracking-wider text-text-muted mb-1 qv2p-choice-label">
                      {c.label}
                    </div>
                    <div class="qv2p-blocks">
                      {c.blocks.map((b) => <QuestionBlockRenderer block={b} />)}
                    </div>
                  </button>
                </li>
              ))}
            </ol>
          </section>

          <section
            class="qv2p-section qv2p-feedback hidden"
            data-testid="qv2p-feedback"
          >
            <div
              class="font-mono text-[11px] uppercase tracking-wider mb-2 qv2p-feedback-status"
              data-testid="qv2p-feedback-status"
            ></div>
            {q.explanationBlocks && q.explanationBlocks.length > 0 && (
              <>
                <h3 class="qv2p-section-title">Explanation</h3>
                <div class="qv2p-explanation-sections" data-testid="qv2p-explanation-sections">
                  {q.choices.map((choice) => (
                    <section class="qv2p-explanation-card" data-testid="qv2p-explanation-card">
                      <h4>{`Why ${choice.label} is ${choice.isCorrect ? 'correct' : 'wrong'}`}</h4>
                      <div class="qv2p-blocks">
                        {choice.isCorrect ? q.explanationBlocks.map((b) => <QuestionBlockRenderer block={b} />) : choice.blocks.map((b) => <QuestionBlockRenderer block={b} />)}
                      </div>
                    </section>
                  ))}
                </div>
              </>
            )}
          </section>

          {q.sourceRefs && q.sourceRefs.length > 0 && (
            <section class="qv2p-section qv2p-feedback hidden" data-testid="qv2p-source-refs">
              <h3 class="qv2p-section-title">Source references</h3>
              <ul class="text-sm text-text-body space-y-1">
                {q.sourceRefs.map((ref) => {
                  const label = sourceRefLabel(ref);
                  const href = sourceRefHref(ref, base);
                  return (
                    <li class="font-mono text-[12px]">
                      <span class="inline-block min-w-[90px] text-text-muted">[{ref.kind}]</span>
                      {href ? (
                        <a href={href} class="text-text-primary underline hover:text-accent-blue" data-testid="qv2p-source-ref-link">{label}</a>
                      ) : (
                        <span class="text-text-primary">{label}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
        </section>
      ))}
    </article>
  </main>
</StudyLayout>

<style>
  .qv2p-section { margin-top: 1.25rem; }
  .qv2p-section-title {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted, #8b95a5);
    margin-bottom: 0.5rem;
  }
  .qv2p-blocks > * + * { margin-top: 0.5rem; }
  .qv2p-explanation-sections {
    display: grid;
    gap: 0.75rem;
  }
  .qv2p-explanation-card {
    border: 1px solid var(--color-border, #1a2035);
    border-radius: 0.5rem;
    background: var(--surface-inset, #090d17);
    padding: 0.75rem;
  }
  .qv2p-explanation-card h4 {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-primary, #e0e4ea);
  }
  .qv2p-explanation-card .qv2p-blocks p {
    margin: 0;
  }
  .qv2p-blocks p { line-height: 1.62; white-space: pre-wrap; }
  .qv2p-blocks img {
    max-width: 100%;
    height: auto;
    background: var(--color-bg-surface, #0d1220);
    border: 1px solid var(--color-border, #1a2035);
    padding: 8px;
    border-radius: 4px;
  }
  .qv2p-blocks figure { margin: 0; }
  .qv2p-blocks figcaption {
    font-size: 11px;
    color: var(--color-text-muted, #8b95a5);
    margin-top: 4px;
    text-align: center;
  }
  .qv2p-blocks table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .qv2p-blocks th, .qv2p-blocks td {
    border: 1px solid var(--color-border, #1a2035);
    padding: 4px 8px;
    text-align: left;
  }
  .qv2p-blocks pre {
    background: var(--surface-inset, #090d17);
    border: 1px solid var(--color-border, #1a2035);
    padding: 8px 10px;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 12px;
  }
  .qv2p-choice {
    background: var(--surface-inset, #090d17);
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .qv2p-choice.is-selected {
    border-color: var(--color-accent-blue, #60a5fa);
    background: color-mix(in srgb, var(--color-accent-blue) 9%, var(--surface-inset));
  }
  .qv2p-choice.is-correct {
    border-color: var(--color-mastery-ok, #34d399);
    background: color-mix(in srgb, var(--color-mastery-ok) 10%, var(--surface-inset));
  }
  .qv2p-choice.is-incorrect {
    border-color: var(--color-mastery-weak, #f87171);
    background: color-mix(in srgb, var(--color-mastery-weak) 10%, var(--surface-inset));
  }
  .qv2p-choice.is-revealed-correct {
    border-color: var(--color-mastery-ok, #34d399);
  }
  .qv2p-choice[disabled] { cursor: default; }
  @media (max-width: 640px) {
    [data-testid="qv2p-session"] .flex { align-items: stretch; }
    [data-testid="qv2p-session"] button, [data-testid="qv2p-session"] a { min-height: 44px; flex: 1 1 42%; }
    .qv2p-choice { min-height: 44px; }
    [data-testid="qv2p-results"] .flex a,
    [data-testid="qv2p-results"] .flex button { flex: 1 1 100%; justify-content: center; }
  }
</style>

<script>
  import {
    buildQuizSession,
    type QuizSession,
    type QuizSessionFilters,
  } from '../../utils/quiz-v2-session';
  import {
    assertCreateQuizV2SessionResponse,
    buildCreateQuizV2SessionPayload,
  } from '../../utils/quiz-v2-backend-session';
  import { createQuizV2Session, submitQuizResults } from '../../utils/auth-client';
  import type { StructuredQuestion } from '../../types/question-blocks';

  interface SessionMetaRow {
    slug: string;
    examYear: number;
    track: string;
    status: string;
    quizEligible: boolean;
    requiresReference: boolean;
    title: string;
    topics: unknown[];
  }

  const DEFAULT_COUNT = 10;

  function readSessionMeta(): SessionMetaRow[] {
    const node = document.getElementById('qv2p-session-meta');
    if (!node || !node.textContent) return [];
    try {
      const parsed = JSON.parse(node.textContent);
      return Array.isArray(parsed) ? (parsed as SessionMetaRow[]) : [];
    } catch {
      return [];
    }
  }

  function metaToQuestion(row: SessionMetaRow): StructuredQuestion {
    return {
      schemaVersion: 1,
      slug: row.slug,
      examYear: row.examYear,
      examType: '',
      questionNumber: 0,
      track: row.track,
      title: row.title,
      status: row.status,
      quizEligible: row.quizEligible,
      requiresReference: row.requiresReference,
      officialAnswerLabel: '',
      acceptedAnswerLabels: [],
      stemBlocks: [],
      choices: [],
      explanationBlocks: [],
      topics: row.topics,
      sourceRefs: [],
      legacy: {},
    };
  }

  function parseFiltersFromUrl(params: URLSearchParams): {
    filters: QuizSessionFilters;
    seed?: string;
  } {
    const filters: QuizSessionFilters = {};
    const yearsRaw = params.get('years');
    if (yearsRaw) {
      const years = yearsRaw
        .split(',')
        .map((s) => Number(s.trim()))
        .filter((n) => Number.isFinite(n));
      if (years.length) filters.years = years;
    }
    const tracksRaw = params.get('tracks');
    if (tracksRaw) {
      filters.tracks = tracksRaw.split(',').map((s) => s.trim()).filter(Boolean);
    }
    const topicsRaw = params.get('topics');
    if (topicsRaw) {
      filters.topicSlugs = topicsRaw.split(',').map((s) => s.trim()).filter(Boolean);
    }
    const slugsRaw = params.get('slugs');
    if (slugsRaw) {
      filters.questionSlugs = slugsRaw.split(',').map((slug) => slug.trim()).filter(Boolean);
    }
    const refMode = params.get('ref');
    if (refMode === 'include' || refMode === 'exclude' || refMode === 'only') {
      filters.referenceMode = refMode;
    }
    const countRaw = params.get('count');
    if (countRaw) {
      const n = Number(countRaw);
      if (Number.isFinite(n) && n > 0) filters.count = n;
    } else {
      filters.count = DEFAULT_COUNT;
    }
    const seed = params.get('seed') ?? undefined;
    return { filters, seed };
  }

  type ChoiceState = { label: string; correct: boolean };
  type Selections = Map<string, string>;

  const selections: Selections = new Map();
  const elapsedBySlug: Map<string, number> = new Map();
  let questionShownAt = Date.now();
  let currentIndex = 0;
  let session: QuizSession | null = null;
  let currentFilters: QuizSessionFilters = {};
  let currentSeed: string | undefined;

  function setText(testid: string, text: string): void {
    const el = document.querySelector(`[data-testid="${testid}"]`);
    if (el) el.textContent = text;
  }

  function describeList(values: readonly (string | number)[], emptyLabel: string): string {
    return values.length > 0 ? values.join(', ') : emptyLabel;
  }

  function summarizeSession(nextSession: QuizSession): string {
    const f = nextSession.filters;
    const parts: string[] = [];
    if (f.questionSlugs.length > 0) {
      parts.push(`Graph builder · ${f.questionSlugs.length} selected question${f.questionSlugs.length === 1 ? '' : 's'}`);
    } else {
      parts.push(`${nextSession.questionSlugs.length}-question session`);
    }
    if (f.years.length > 0) parts.push(`Years ${describeList(f.years, 'all')}`);
    if (f.tracks.length > 0) parts.push(`Tracks ${describeList(f.tracks, 'all')}`);
    if (f.topicSlugs.length > 0) parts.push(`Topics ${describeList(f.topicSlugs, 'all')}`);
    if (f.referenceMode === 'exclude') parts.push('reference-required excluded');
    if (f.referenceMode === 'only') parts.push('reference-required only');
    return parts.join(' · ');
  }

  function detailFor(slug: string): HTMLElement | null {
    return document.querySelector<HTMLElement>(`[data-qv2p-detail="${slug}"]`);
  }

  function hideAllDetails(): void {
    document.querySelectorAll<HTMLElement>('[data-qv2p-detail]').forEach((el) => {
      el.classList.add('hidden');
    });
  }

  function resetChoiceState(detail: HTMLElement): void {
    detail.querySelectorAll<HTMLButtonElement>('.qv2p-choice').forEach((btn) => {
      btn.classList.remove('is-selected', 'is-correct', 'is-incorrect', 'is-revealed-correct');
      btn.removeAttribute('disabled');
    });
    detail.querySelectorAll<HTMLElement>('.qv2p-feedback').forEach((el) => {
      el.classList.add('hidden');
    });
  }

  function applyRevealedState(detail: HTMLElement, chosen: string): void {
    const correctLabel = detail.getAttribute('data-correct-label') ?? '';
    const isRight = chosen === correctLabel;
    detail.querySelectorAll<HTMLButtonElement>('.qv2p-choice').forEach((btn) => {
      const label = btn.getAttribute('data-choice-label') ?? '';
      const correct = btn.getAttribute('data-correct') === 'true';
      btn.setAttribute('disabled', 'disabled');
      if (label === chosen) {
        btn.classList.add('is-selected');
        btn.classList.add(correct ? 'is-correct' : 'is-incorrect');
      }
      if (correct && label !== chosen) {
        btn.classList.add('is-revealed-correct');
      }
    });
    detail.querySelectorAll<HTMLElement>('.qv2p-feedback').forEach((el) => {
      el.classList.remove('hidden');
    });
    const status = detail.querySelector<HTMLElement>('[data-testid="qv2p-feedback-status"]');
    if (status) {
      status.textContent = isRight
        ? `Correct · official answer ${correctLabel}`
        : `Incorrect · official answer ${correctLabel}`;
      status.className = `font-mono text-[11px] uppercase tracking-wider mb-2 qv2p-feedback-status ${isRight ? 'text-mastery-ok' : 'text-mastery-weak'}`;
    }
  }

  function showCurrent(): void {
    if (!session) return;
    const empty = document.getElementById('qv2p-empty');
    const noResults = document.getElementById('qv2p-no-results');
    const results = document.getElementById('qv2p-results');
    hideAllDetails();
    if (results) results.classList.add('hidden');
    if (empty) empty.classList.add('hidden');
    if (session.questionSlugs.length === 0) {
      if (noResults) noResults.classList.remove('hidden');
      setText('qv2p-session-index', '0');
      return;
    }
    if (noResults) noResults.classList.add('hidden');
    const slug = session.questionSlugs[currentIndex];
    const detail = detailFor(slug);
    if (!detail) return;
    detail.classList.remove('hidden');
    resetChoiceState(detail);
    const chosen = selections.get(slug);
    if (chosen) {
      applyRevealedState(detail, chosen);
    }
    setText('qv2p-session-index', String(currentIndex + 1));
    const prev = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-prev"]');
    const next = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-next"]');
    const finish = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-finish"]');
    if (prev) prev.disabled = currentIndex === 0;
    if (next) {
      const canMoveNext = Boolean(chosen) && currentIndex < session.questionSlugs.length - 1;
      next.disabled = !canMoveNext;
      next.textContent = currentIndex >= session.questionSlugs.length - 1 ? 'Last question' : 'Next ›';
    }
    if (finish) finish.disabled = selections.size < session.questionSlugs.length;
    updateSubmitButton();
    questionShownAt = Date.now();
  }

  function attachChoiceHandlers(): void {
    document.querySelectorAll<HTMLButtonElement>('.qv2p-choice').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.hasAttribute('disabled')) return;
        const detail = btn.closest<HTMLElement>('[data-qv2p-detail]');
        if (!detail) return;
        const slug = detail.getAttribute('data-qv2p-detail') ?? '';
        const label = btn.getAttribute('data-choice-label') ?? '';
        if (!slug || !label) return;
        selections.set(slug, label);
        elapsedBySlug.set(slug, Date.now() - questionShownAt);
        applyRevealedState(detail, label);
        const next = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-next"]');
        if (next && session) next.disabled = currentIndex >= session.questionSlugs.length - 1;
        updateSubmitButton();
        const finish = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-finish"]');
        if (finish && session) finish.disabled = selections.size < session.questionSlugs.length;
      });
    });
  }

  function attachNavHandlers(): void {
    const prev = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-prev"]');
    const next = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-next"]');
    const finish = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-finish"]');
    const review = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-results-review"]');
    prev?.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        showCurrent();
      }
    });
    next?.addEventListener('click', () => {
      if (session && currentIndex < session.questionSlugs.length - 1) {
        currentIndex++;
        showCurrent();
      }
    });
    finish?.addEventListener('click', () => finishSession());
    review?.addEventListener('click', () => {
      if (!session || session.questionSlugs.length === 0) return;
      currentIndex = 0;
      showCurrent();
    });
  }

  function currentFilterParams(): string {
    const params = new URLSearchParams();
    if (currentSeed) params.set('seed', currentSeed);
    if (currentFilters.count && currentFilters.count !== DEFAULT_COUNT) params.set('count', String(currentFilters.count));
    if (currentFilters.years && currentFilters.years.length > 0) params.set('years', currentFilters.years.join(','));
    if (currentFilters.tracks && currentFilters.tracks.length > 0) params.set('tracks', currentFilters.tracks.join(','));
    if (currentFilters.topicSlugs && currentFilters.topicSlugs.length > 0) params.set('topics', currentFilters.topicSlugs.join(','));
    if (currentFilters.questionSlugs && currentFilters.questionSlugs.length > 0) params.set('slugs', currentFilters.questionSlugs.join(','));
    if (currentFilters.referenceMode && currentFilters.referenceMode !== 'include') params.set('ref', currentFilters.referenceMode);
    return params.toString();
  }

  function updateSessionLinks(): void {
    const query = currentFilterParams();
    const suffix = query ? `?${query}` : '';
    const adjust = document.querySelector<HTMLAnchorElement>('[data-testid="qv2p-adjust-set"]');
    if (adjust) adjust.href = `${adjust.pathname}${suffix}`;
    const again = document.querySelector<HTMLAnchorElement>('[data-testid="qv2p-practice-again"]');
    if (again) again.href = `${again.pathname}${suffix}`;
    const build = document.querySelector<HTMLAnchorElement>('[data-testid="qv2p-build-new-set"]');
    if (build) build.href = `${build.pathname}${suffix}`;
  }

  function applySession(
    nextSession: QuizSession,
    sourceLabel = 'Local deterministic session',
    options: { preserveAnswers?: boolean } = {}
  ): void {
    const previousSlug = session?.questionSlugs[currentIndex];
    const previousSelections = new Map(selections);
    const previousElapsed = new Map(elapsedBySlug);
    session = nextSession;
    currentIndex = previousSlug ? Math.max(0, session.questionSlugs.indexOf(previousSlug)) : 0;
    if (currentIndex < 0) currentIndex = 0;
    selections.clear();
    elapsedBySlug.clear();
    if (options.preserveAnswers) {
      const nextSlugs = new Set(session.questionSlugs);
      for (const [slug, label] of previousSelections.entries()) {
        if (nextSlugs.has(slug)) selections.set(slug, label);
      }
      for (const [slug, elapsed] of previousElapsed.entries()) {
        if (nextSlugs.has(slug)) elapsedBySlug.set(slug, elapsed);
      }
    }
    setText('qv2p-session-id', session.backendSessionId ? `${session.sessionId} / ${session.backendSessionId}` : session.sessionId);
    setText('qv2p-session-seed', session.seed);
    setText('qv2p-session-count', String(session.questionSlugs.length));
    setText('qv2p-session-total', String(session.totalEligible));
    setText('qv2p-session-summary', summarizeSession(session));
    setText('qv2p-session-filters', JSON.stringify(session.filters));
    setText('qv2p-session-source', sourceLabel);
    updateSessionLinks();
    showCurrent();
  }

  function finishSession(): void {
    if (!session || selections.size < session.questionSlugs.length) return;
    hideAllDetails();
    document.getElementById('qv2p-empty')?.classList.add('hidden');
    document.getElementById('qv2p-no-results')?.classList.add('hidden');
    const results = document.getElementById('qv2p-results');
    const score = scoreCurrentSession();
    if (results) results.classList.remove('hidden');
    setText('qv2p-results-score', `Score ${score.correct}/${score.total} (${Math.round((score.total > 0 ? score.correct / score.total : 0) * 100)}%). Review your answers, practice again, build a new set, or open My Progress.`);
    void submitProgress();
  }

  function updateSubmitButton(): void {
    const submit = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-submit-results"]');
    if (!submit) return;
    submit.disabled = selections.size === 0;
  }

  function scoreCurrentSession(): { correct: number; answered: number; total: number; score: number } {
    if (!session) return { correct: 0, answered: 0, total: 0, score: 0 };
    let correct = 0;
    for (const [slug, selected] of selections.entries()) {
      const detail = detailFor(slug);
      if (detail && selected === (detail.getAttribute('data-correct-label') ?? '')) correct++;
    }
    const answered = selections.size;
    return { correct, answered, total: session.questionSlugs.length, score: answered > 0 ? correct / answered : 0 };
  }

  async function submitProgress(): Promise<void> {
    const button = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-submit-results"]');
    if (!session || !button || selections.size === 0) return;
    button.disabled = true;
    setText('qv2p-submit-status', 'Saving progress…');
    try {
      const result = await submitQuizResults({
        quizSessionId: session.backendSessionId,
        source: 'quiz-v2',
        title: 'Quiz v2 generated session',
        quizType: session.filters.topicSlugs.length === 1 ? 'topic' : 'custom',
        feedbackMode: 'immediate',
        completionMode: selections.size >= session.questionSlugs.length ? 'completed' : 'early',
        filters: {
          schemaVersion: 1,
          source: 'quiz-v2',
          seed: session.seed,
          stableSessionId: session.sessionId,
          filters: session.filters,
          questionSlugs: session.questionSlugs,
        },
        questions: session.questionSlugs.map((slug, index) => ({
          slug,
          position: index + 1,
          selectedLabel: selections.get(slug) ?? null,
          timeMs: elapsedBySlug.get(slug) ?? null,
        })),
      });
      const score = scoreCurrentSession();
      setText('qv2p-submit-status', `Saved ${result.attemptsInserted} attempt(s). Score ${score.correct}/${score.answered} (${Math.round(score.score * 100)}%). Review in History.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'request_failed';
      setText('qv2p-submit-status', message === 'not_authenticated'
        ? 'Log in to save progress. Your local preview remains available.'
        : 'Progress saving is unavailable right now. You can still practice locally.');
    } finally {
      updateSubmitButton();
    }
  }

  async function createBackendSession(): Promise<void> {
    const button = document.querySelector<HTMLButtonElement>('[data-testid="qv2p-create-backend-session"]');
    if (!button) return;
    button.disabled = true;
    setText('qv2p-session-source', 'Preparing saved progress…');
    try {
      const payload = buildCreateQuizV2SessionPayload(currentFilters, currentSeed ? { seed: currentSeed } : {});
      const response = assertCreateQuizV2SessionResponse(await createQuizV2Session(payload));
      applySession(
        response.session,
        response.source === 'backend' ? 'Progress saving ready' : 'Preview mode · log in to save progress',
        { preserveAnswers: true }
      );
      setText('qv2p-submit-status', response.source === 'backend' ? 'Progress saving is ready. Answer questions, then submit progress.' : 'Preview mode. Log in to save progress.');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'request_failed';
      setText('qv2p-session-source', message === 'not_authenticated'
        ? 'Preview mode · log in to save progress'
        : 'Progress saving is unavailable. You can still practice locally.');
    } finally {
      button.disabled = false;
    }
  }

  function attachSubmitHandler(): void {
    document
      .querySelector<HTMLButtonElement>('[data-testid="qv2p-submit-results"]')
      ?.addEventListener('click', () => { void submitProgress(); });
  }

  function attachBackendSessionHandler(): void {
    document
      .querySelector<HTMLButtonElement>('[data-testid="qv2p-create-backend-session"]')
      ?.addEventListener('click', () => { void createBackendSession(); });
  }

  function init(): void {
    const meta = readSessionMeta();
    const candidateQuestions = meta.map(metaToQuestion);
    const params = new URLSearchParams(window.location.search);
    const { filters, seed } = parseFiltersFromUrl(params);
    const sessionSeed = seed ?? `practice-${Date.now()}-${Math.floor(Math.random() * 0x7fffffff)}`;
    currentFilters = filters;
    currentSeed = sessionSeed;
    applySession(buildQuizSession(candidateQuestions, filters, { seed: sessionSeed }), 'Preview mode · log in to save progress');
    attachChoiceHandlers();
    attachNavHandlers();
    attachBackendSessionHandler();
    attachSubmitHandler();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
