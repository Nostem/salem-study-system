    { type: 'Simulator', slug: '2014-jpm-sim-a', label: 'Sim-a' },
    { type: 'Simulator', slug: '2014-jpm-sim-b', label: 'Sim-b' },
    { type: 'Simulator', slug: '2014-jpm-sim-c', label: 'Sim-c' },
    { type: 'Simulator', slug: '2014-jpm-sim-d', label: 'Sim-d' },
    { type: 'Simulator', slug: '2014-jpm-sim-e', label: 'Sim-e' },
    { type: 'Simulator', slug: '2014-jpm-sim-f', label: 'Sim-f' },
