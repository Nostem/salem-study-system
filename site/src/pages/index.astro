const scenarioSlugs: Record<string, string[]> = {
  '2023': ['2023-scenario-01', '2023-scenario-02', '2023-scenario-03', '2023-scenario-04'],
  '2022': ['2022-scenario-01', '2022-scenario-03', '2022-scenario-04'],
  '2020': ['2020-scenario-01', '2020-scenario-02', '2020-scenario-03', '2020-scenario-04', '2020-scenario-05'],
  '2019': ['2019-scenario-01', '2019-scenario-03', '2019-scenario-04'],
  '2018': ['2018-scenario-01', '2018-scenario-02'],
  '2017': ['2017-scenario-07', '2017-scenario-08'],
  '2016': ['2016-scenario-01', '2016-scenario-02', '2016-scenario-03'],
  '2015': ['2015-scenario-01', '2015-scenario-02', '2015-scenario-03', '2015-scenario-04'],
  '2014': ['2014-scenario-01', '2014-scenario-02', '2014-scenario-03', '2014-scenario-04'],
