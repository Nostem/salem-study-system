    { type: 'RO Admin', slug: '2012-jpm-ro-a2', label: 'RO-A2' },
    { type: 'RO Admin', slug: '2012-jpm-ro-a3', label: 'RO-A3' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a1-1', label: 'SRO-A1-1' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a1-2', label: 'SRO-A1-2' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a2', label: 'SRO-A2' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a3', label: 'SRO-A3' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a4-1', label: 'SRO-A4-1' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a4-2', label: 'SRO-A4-2' },
    { type: 'SRO Admin', slug: '2012-jpm-sro-a4-3', label: 'SRO-A4-3' },
    { type: 'Simulator', slug: '2012-jpm-sim-a', label: 'Sim-a' },
