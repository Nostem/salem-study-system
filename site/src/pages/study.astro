---
import StudyLayout from '../layouts/StudyLayout.astro';
import { getStructuredQuestions, getStructuredExamYears } from '../utils/structured-quiz-data';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const questions = getStructuredQuestions();
const examYears = getStructuredExamYears();
const eligibleQuestions = questions.filter((q) => q.quizEligible).length;
const practiceTopicSlugs = new Set<string>();
for (const q of questions) {
  if (!q.quizEligible) continue;
  for (const topic of q.topics) {
    if (!topic || typeof topic !== 'object' || !('slug' in topic)) continue;
    const slug = String((topic as { slug?: unknown }).slug ?? '');
    if (slug) practiceTopicSlugs.add(slug);
  }
}
const practiceReadyTopics = practiceTopicSlugs.size;

const quickHref = `${base}quiz/`;
const reviewHref = `${base}quiz-v2/review/`;
const mapHref = `${base}graph-v2/`;
const progressHref = `${base}history/`;
const builderHref = `${base}quiz-v2/`;
---

<StudyLayout title="Study" active="study">
  <main class="mx-auto max-w-[1120px] px-4 py-6 sm:px-6 lg:py-10">
    <header class="mb-6 rounded-2xl border border-border bg-bg-card p-5 sm:p-7">
      <a href={base} class="mb-4 inline-flex text-[11px] font-mono text-text-muted no-underline hover:text-accent-blue">&lsaquo; Back to wiki</a>
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-blue mb-2">Learner hub</div>
      <div class="grid gap-5 lg:grid-cols-[1fr_320px] lg:items-end">
        <div>
          <h1 class="font-serif text-4xl sm:text-5xl text-text-primary leading-tight">Study</h1>
          <p class="mt-3 max-w-2xl text-sm sm:text-base text-text-body leading-relaxed">
            Practice NRC exam questions, target weak areas, and track your progress.
          </p>
          <p data-testid="study-auth-status" class="mt-3 text-xs font-mono text-text-muted">
            Browsing as a guest — log in to save quiz results and track progress.
          </p>
        </div>
        <section
          data-testid="study-continue-banner"
          class="hidden rounded-xl border border-accent-blue bg-accent-blue/10 p-4"
          aria-live="polite"
        >
          <div class="text-xs font-mono uppercase tracking-wider text-accent-blue">Pick up where you left off</div>
          <p data-testid="study-continue-reason" class="mt-2 text-sm text-text-body">
            Questions are due for review.
          </p>
          <a
            data-testid="study-continue-action"
            href={reviewHref}
            class="mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-accent-blue bg-accent-blue/15 px-4 py-3 text-sm font-semibold text-accent-blue no-underline hover:bg-accent-blue/25"
          >Review due questions →</a>
        </section>
      </div>
    </header>

    <section class="grid gap-3 sm:grid-cols-3 mb-6" aria-label="Study bank summary">
      <div class="rounded-lg border border-border bg-bg-card p-4">
        <div class="font-mono text-2xl text-text-primary" data-testid="study-eligible-count">{eligibleQuestions}</div>
        <div class="font-mono text-[10px] uppercase tracking-wider text-text-muted">practice questions</div>
      </div>
      <div class="rounded-lg border border-border bg-bg-card p-4">
        <div class="font-mono text-2xl text-text-primary">{examYears.length}</div>
        <div class="font-mono text-[10px] uppercase tracking-wider text-text-muted">exam years</div>
      </div>
      <div class="rounded-lg border border-border bg-bg-card p-4">
        <div class="font-mono text-2xl text-text-primary">{practiceReadyTopics}</div>
        <div class="font-mono text-[10px] uppercase tracking-wider text-text-muted">topic pools</div>
      </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-3" aria-label="Study choices">
      <a data-testid="study-card-quick" href={quickHref} class="study-card study-card-primary">
        <span class="study-card-kicker">Recommended</span>
        <strong>Quick Quiz</strong>
        <span>Jump into a fast practice set — pick a year or topic, answer, and get your score.</span>
        <span class="study-card-action">Start →</span>
      </a>

      <article data-testid="study-card-advanced" class="study-card">
        <span class="study-card-kicker">Targeted practice</span>
        <strong>Advanced Quiz</strong>
        <span>Build a targeted set with detailed filters, or explore topics visually before you practice.</span>
        <div class="mt-auto grid gap-2">
          <a data-testid="study-card-advanced-build" href={builderHref} class="study-card-button">Build a custom set →</a>
          <a data-testid="study-card-advanced-map" href={mapHref} class="study-card-button">Open Study Map →</a>
        </div>
      </article>

      <a data-testid="study-card-progress" href={progressHref} class="study-card">
        <span class="study-card-kicker">History and review</span>
        <strong>My Progress</strong>
        <span>See past scores, weak topics, and questions due for review.</span>
        <span class="study-card-action">Open →</span>
      </a>
    </section>
  </main>
</StudyLayout>

<style>
  .study-card {
    display: flex;
    min-height: 224px;
    flex-direction: column;
    gap: 0.75rem;
    border: 1px solid var(--color-border, #1a2035);
    border-radius: 1rem;
    background: var(--color-bg-card, #101827);
    padding: 1.25rem;
    color: var(--color-text-body, #c8cdd5);
    text-decoration: none;
    transition: border-color 140ms ease, transform 140ms ease, background 140ms ease;
  }
  .study-card:hover {
    border-color: var(--color-accent-blue, #60a5fa);
    background: rgba(96, 165, 250, 0.06);
    transform: translateY(-1px);
  }
  .study-card-primary {
    border-color: rgba(96, 165, 250, 0.55);
  }
  .study-card strong {
    color: var(--color-text-primary, #e0e4ea);
    font-family: var(--font-serif, serif);
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .study-card-kicker {
    color: var(--color-accent-blue, #60a5fa);
    font-family: var(--font-mono, monospace);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .study-card-action {
    margin-top: auto;
    color: var(--color-accent-blue, #60a5fa);
    font-weight: 700;
  }
  .study-card-button {
    align-items: center;
    border: 1px solid var(--color-border, #1a2035);
    border-radius: 0.65rem;
    color: var(--color-accent-blue, #60a5fa);
    display: inline-flex;
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    text-decoration: none;
  }
  .study-card-button:hover { background: rgba(96, 165, 250, 0.08); }
</style>

<script>
  import { getCurrentSession, getQuizReviewQueue, hasSupabaseConfig } from '../utils/auth-client';

  const base = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';

  function setStudyText(testid: string, text: string): void {
    const el = document.querySelector(`[data-testid="${testid}"]`);
    if (el) el.textContent = text;
  }

  function showContinueBanner(count: number): void {
    const banner = document.querySelector<HTMLElement>('[data-testid="study-continue-banner"]');
    const action = document.querySelector<HTMLAnchorElement>('[data-testid="study-continue-action"]');
    if (!banner || !action) return;
    banner.classList.remove('hidden');
    action.href = `${base}quiz-v2/review/`;
    action.textContent = `Review ${count} due question${count === 1 ? '' : 's'} →`;
    setStudyText('study-continue-reason', `${count} question${count === 1 ? ' is' : 's are'} due for review.`);
  }

  async function initStudyStatus(): Promise<void> {
    if (!hasSupabaseConfig()) {
      setStudyText('study-auth-status', 'Progress saving is unavailable here. You can still browse Study.');
      return;
    }

    try {
      const session = await getCurrentSession();
      if (!session?.access_token) {
        setStudyText('study-auth-status', 'Browsing as a guest — log in to save quiz results and track progress.');
        return;
      }

      setStudyText('study-auth-status', 'Signed in — your quiz results are saved automatically.');

      try {
        const queue = await getQuizReviewQueue();
        if (queue.dueSlugs.length > 0) showContinueBanner(queue.dueSlugs.length);
      } catch {
        // Leave the normal three-choice hub visible if review lookup is unavailable.
      }
    } catch {
      setStudyText('study-auth-status', 'Browsing as a guest — log in to save quiz results and track progress.');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { void initStudyStatus(); });
  } else {
    void initStudyStatus();
  }
</script>
