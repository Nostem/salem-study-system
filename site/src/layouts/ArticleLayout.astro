---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import LocalGraph from '../components/LocalGraph.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DraftBadge from '../components/DraftBadge.astro';
import MobileNav from '../components/MobileNav.astro';
import HighlightToolbar from '../components/HighlightToolbar.astro';
import ReviewPill from '../components/ReviewPill.astro';

interface Props {
  title: string;
  category: string;
  status: 'draft' | 'verified' | 'outdated' | 'edited';
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  wide?: boolean;
}

const { title, category, status, slug, headings, wide = false } = Astro.props;
---

<BaseLayout title={title}>
  <div data-pagefind-ignore>
    <HighlightToolbar />
  </div>

  <!-- Mobile nav drawer -->
  <div class="lg:hidden" data-pagefind-ignore>
    <MobileNav>
      <Sidebar currentSlug={slug} sidebarId="mobile-sidebar" sidebarVariant="mobile" />
    </MobileNav>
  </div>


  <div class="flex">
    <!-- Sidebar (desktop) -->
    <div class="hidden lg:block" data-pagefind-ignore>
      <Sidebar currentSlug={slug} sidebarId="desktop-sidebar" sidebarVariant="desktop" />
    </div>

    <!-- Main content -->
    <main id="main-content" class:list={["flex-1 px-8 py-8 xl:px-12", wide ? "max-w-[1200px]" : "max-w-[800px]"]}>
      {!wide && <div data-pagefind-ignore><Breadcrumbs category={category} title={title} /></div>}
      {!wide && (
        <div class="flex items-center gap-2.5 mb-1.5 flex-wrap">
          <h1 class="text-2xl text-text-primary font-semibold m-0" data-pagefind-meta="title">{title}</h1>
          <div data-pagefind-ignore class="contents">
            <DraftBadge status={status} />
            <ReviewPill slug={slug} />
          </div>
        </div>
      )}
      <div data-pagefind-meta={`category:${category}, status:${status}`}></div>
      <article class:list={[wide ? "" : "prose mt-6"]} data-slug={slug} data-pagefind-body>
        <slot />
      </article>
    </main>

    <!-- Right rail: local graph + TOC (desktop) — hidden in wide mode -->
    {!wide && (
      <aside class="w-[420px] min-w-[420px] border-l border-border px-4 py-6 text-[11px] text-text-muted h-[calc(100vh-3.25rem)] sticky top-[3.25rem] overflow-y-auto hidden xl:block" data-pagefind-ignore>
        <LocalGraph currentSlug={slug} />
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>

  <script src="../scripts/highlighter.ts"></script>
</BaseLayout>
