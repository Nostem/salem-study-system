---
// Pagefind search modal — initialized client-side
import { resolvePagefindAssetDir } from '../../scripts/pagefind-assets.mjs';

const base = import.meta.env.BASE_URL;
const pagefindAssetDir = resolvePagefindAssetDir();
---

<div id="search-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="search-modal-title" hidden data-pagefind-ignore>
  <!-- Backdrop -->
  <button type="button" class="absolute inset-0 h-full w-full cursor-default bg-black/60" aria-label="Close search" data-search-close></button>

  <!-- Modal -->
  <div class="relative mx-auto mt-[15vh] w-[calc(100%-2rem)] max-w-lg bg-[#0d1220] border border-[#1a2035] rounded-lg shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between gap-3 border-b border-[#1a2035] px-4 py-3">
      <h2 id="search-modal-title" class="m-0 text-sm font-semibold text-[#e0e4ea]">Search Salem Study</h2>
      <button type="button" class="rounded border border-[#1a2035] px-2 py-1 text-xs text-[#8b95a5] hover:text-[#e0e4ea]" aria-label="Close search" data-search-close>Esc</button>
    </div>
    <div class="p-4">
      <label for="search-input" class="sr-only">Search articles</label>
      <input
        id="search-input"
        type="text"
        placeholder="Search articles..."
        class="w-full bg-[#111827] border border-[#1a2035] rounded-md px-4 py-2.5 text-sm text-[#e0e4ea] placeholder-[#8b95a5] outline-none focus:border-[#2a6f97]"
        autocomplete="off"
      />
    </div>
    <div id="search-results" class="max-h-[50vh] overflow-y-auto px-4 pb-4" aria-live="polite">
      <!-- Results populated by Pagefind -->
    </div>
  </div>
</div>

<script is:inline define:vars={{ base, pagefindAssetDir }}>
  const normalizedBase = base.endsWith('/') ? base : `${base}/`;
  const normalizedPagefindAssetDir = pagefindAssetDir.replace(/^\/+|\/+$/g, '');
  const pagefindModulePath = `${normalizedBase}${normalizedPagefindAssetDir}/pagefind.js`;
  const searchFallbackPath = `${normalizedBase}search-fallback.json`;
  let lastSearchTrigger = null;

  function getSearchElements() {
    return {
      modal: document.getElementById('search-modal'),
      input: document.getElementById('search-input'),
      results: document.getElementById('search-results'),
    };
  }

  function clearResults(results) {
    while (results.firstChild) results.removeChild(results.firstChild);
  }

  function openSearch(event) {
    const { modal, input } = getSearchElements();
    if (!modal || !input) return;

    const trigger = event?.currentTarget instanceof HTMLElement ? event.currentTarget : document.activeElement;
    lastSearchTrigger = trigger instanceof HTMLElement ? trigger : null;
    modal.hidden = false;
    modal.classList.remove('hidden');
    input.focus();
  }

  function closeSearch() {
    const { modal, input, results } = getSearchElements();
    if (!modal || !input || !results) return;

    modal.classList.add('hidden');
    modal.hidden = true;
    input.value = '';
    clearResults(results);
    if (lastSearchTrigger && document.contains(lastSearchTrigger)) lastSearchTrigger.focus();
  }

  // Expose globally so other pages (homepage) can call openSearch/closeSearch
  window.openSearch = openSearch;
  window.closeSearch = closeSearch;

  function bindSearchTriggers() {
    document.querySelectorAll('#search-trigger, #search-trigger-mobile, #home-search-trigger').forEach((trigger) => {
      if (trigger.dataset.searchBound === 'true') return;
      trigger.dataset.searchBound = 'true';
      trigger.addEventListener('click', (event) => openSearch(event));
    });
  }

  // Keyboard shortcut: Cmd+K / Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const { modal } = getSearchElements();
      if (!modal) return;

      if (modal.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === 'Escape') closeSearch();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindSearchTriggers, { once: true });
  } else {
    bindSearchTriggers();
  }
  document.addEventListener('astro:page-load', bindSearchTriggers);

  // Pagefind excerpts are HTML with <mark> highlights. Build them as text
  // nodes + real <mark> elements (never innerHTML — excerpts derive from
  // article content) and strip any other tags.
  function appendExcerpt(container, excerptHtml) {
    const stripTags = (value) => value.replace(/<[^>]*>/g, '');
    const parts = String(excerptHtml).split(/<mark>([\s\S]*?)<\/mark>/g);
    parts.forEach((part, index) => {
      const text = stripTags(part);
      if (!text) return;
      if (index % 2 === 1) {
        const mark = document.createElement('mark');
        mark.textContent = text;
        container.appendChild(mark);
      } else {
        container.appendChild(document.createTextNode(text));
      }
    });
  }

  function renderSearchResults(results, items, { degraded = false } = {}) {
    clearResults(results);
    if (degraded) {
      const notice = document.createElement('div');
      notice.className = 'px-3 py-2 text-[11px] text-[#8b95a5] border-b border-[#1a2035] mb-1';
      notice.textContent = 'Basic search — the fast index could not load on this network.';
      results.appendChild(notice);
    }
    if (degraded && items.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'px-3 py-3 text-xs text-[#8b95a5]';
      empty.textContent = 'No matches.';
      results.appendChild(empty);
      return;
    }
    for (const item of items) {
      const href = typeof item.url === 'string' ? item.url : '#';
      const link = document.createElement('a');
      link.href = href;
      link.className = 'block px-3 py-2.5 rounded-md hover:bg-[#111827] no-underline mb-1 transition-colors';

      const title = document.createElement('div');
      title.className = 'text-sm text-[#e0e4ea] font-medium';
      title.textContent = item.meta?.title || 'Untitled';

      const excerpt = document.createElement('div');
      excerpt.className = 'text-xs text-[#8b95a5] mt-0.5 line-clamp-2';
      appendExcerpt(excerpt, item.excerpt || '');

      link.appendChild(title);
      link.appendChild(excerpt);
      results.appendChild(link);
    }
  }

  function renderSearchError(results, message, { recoverable = false } = {}) {
    clearResults(results);
    const container = document.createElement('div');
    container.className = 'px-3 py-4 text-xs text-[#f87171]';

    const text = document.createElement('p');
    text.className = 'm-0';
    text.textContent = message;
    container.appendChild(text);

    // The recoverable cases (stale/corrupt cache, failed load) are cleared by a
    // fresh page load, which resets Pagefind's in-memory state and revalidates
    // the (non-immutable) index assets. Give the user a one-click way to do it
    // instead of leaving passive "refresh the page" text they may not act on.
    if (recoverable) {
      const reload = document.createElement('button');
      reload.type = 'button';
      reload.className = 'mt-2 rounded border border-[#1a2035] px-2 py-1 text-[#e0e4ea] hover:text-white';
      reload.textContent = 'Reload page';
      reload.addEventListener('click', () => window.location.reload());
      container.appendChild(reload);
    }

    results.appendChild(container);
  }

  let pagefindModule = null;
  let pagefindReadyPromise = null;

  function pagefindErrorDetail(err) {
    return (err && (err.message || err.toString())) || 'unknown';
  }

  function isPagefindPointerError(err) {
    return /WASM Error|No pointer/i.test(pagefindErrorDetail(err));
  }

  function staleSearchMessage() {
    return 'Search index cache is stale. Reload the page and try again — if it persists, hard-refresh with Ctrl/Cmd+Shift+R.';
  }

  async function loadPagefind({ cacheBust = false } = {}) {
    const importPath = cacheBust ? `${pagefindModulePath}?retry=${Date.now()}` : pagefindModulePath;
    const pagefind = await import(importPath);
    await pagefind.init();
    pagefindModule = pagefind;
    return pagefindModule;
  }

  function getPagefindReady() {
    if (!pagefindReadyPromise) {
      pagefindReadyPromise = loadPagefind().catch((err) => {
        pagefindReadyPromise = null;
        throw err;
      });
    }
    return pagefindReadyPromise;
  }

  function retryPagefindReady() {
    pagefindModule = null;
    pagefindReadyPromise = loadPagefind({ cacheBust: true }).catch((err) => {
      pagefindReadyPromise = null;
      throw err;
    });
    return pagefindReadyPromise;
  }

  async function searchPagefind(query) {
    const pagefind = await getPagefindReady();
    try {
      return await pagefind.search(query);
    } catch (err) {
      if (!isPagefindPointerError(err)) throw err;

      console.warn('Pagefind search pointer failed; retrying with a fresh module:', err);
      const freshPagefind = await retryPagefindReady();
      try {
        return await freshPagefind.search(query);
      } catch (retryErr) {
        retryErr.pagefindCacheRetryFailed = true;
        throw retryErr;
      }
    }
  }

  // --- Plain-JSON fallback search ---------------------------------------------
  // Pagefind's binary WASM/index assets get corrupted or blocked by some
  // proxies/extensions (search works on other networks/phones but not there).
  // When Pagefind fails, search a text-only index instead. Mirrors
  // rankFallbackMatches in src/utils/search-fallback.ts (unit-tested there;
  // integration-tested in tests/ui-test.ts). This runs inline, so it cannot
  // import that module — keep the two in sync.
  let pagefindUnavailable = false;
  let fallbackIndexPromise = null;

  function loadFallbackIndex() {
    if (!fallbackIndexPromise) {
      fallbackIndexPromise = fetch(searchFallbackPath)
        .then((response) => {
          if (!response.ok) throw new Error(`fallback index ${response.status}`);
          return response.json();
        })
        .then((data) => (Array.isArray(data?.entries) ? data.entries : []))
        .catch((err) => {
          fallbackIndexPromise = null;
          throw err;
        });
    }
    return fallbackIndexPromise;
  }

  function fallbackExcerpt(text, tokens) {
    const lower = text.toLowerCase();
    let pos = -1;
    let matched = '';
    for (const token of tokens) {
      const i = lower.indexOf(token);
      if (i !== -1 && (pos === -1 || i < pos)) {
        pos = i;
        matched = token;
      }
    }
    if (pos === -1) return text.slice(0, 160);
    const start = Math.max(0, pos - 60);
    const end = Math.min(text.length, pos + matched.length + 110);
    const lead = start > 0 ? '…' : '';
    const tail = end < text.length ? '…' : '';
    const hit = text.slice(pos, pos + matched.length);
    return `${lead}${text.slice(start, pos)}<mark>${hit}</mark>${text.slice(pos + matched.length, end)}${tail}`;
  }

  function rankFallbackMatches(entries, query, limit) {
    const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (tokens.length === 0) return [];
    const scored = [];
    for (const entry of entries) {
      const title = String(entry.title || '').toLowerCase();
      const text = String(entry.text || '').toLowerCase();
      if (!tokens.every((token) => title.includes(token) || text.includes(token))) continue;
      let score = 0;
      for (const token of tokens) {
        if (title.includes(token)) score += 10;
        if (text.includes(token)) score += 1;
      }
      scored.push({ entry, score });
    }
    scored.sort((a, b) => b.score - a.score || String(a.entry.title).localeCompare(String(b.entry.title)));
    return scored.slice(0, limit).map(({ entry }) => ({
      url: entry.url,
      meta: { title: entry.title },
      excerpt: fallbackExcerpt(String(entry.text || ''), tokens),
    }));
  }

  async function fallbackSearch(query) {
    const entries = await loadFallbackIndex();
    return rankFallbackMatches(entries, query, 10);
  }

  // Try Pagefind first; on failure, transparently use the fallback and mark the
  // results as degraded. Once Pagefind is known-broken this session, skip it.
  async function runSearch(query) {
    if (!pagefindUnavailable) {
      try {
        const search = await searchPagefind(query);
        const items = await Promise.all(search.results.slice(0, 10).map((result) => result.data()));
        return { items, degraded: false };
      } catch (err) {
        console.warn('Pagefind unavailable; using fallback search:', err);
        pagefindUnavailable = true;
      }
    }
    return { items: await fallbackSearch(query), degraded: true };
  }

  function attachInputHandlers() {
    const { input, results, modal } = getSearchElements();
    if (!input || !results || !modal || input.dataset.pagefindBound === 'true') return;

    input.dataset.pagefindBound = 'true';

    modal.querySelectorAll('[data-search-close]').forEach((button) => {
      button.addEventListener('click', closeSearch);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const firstLink = document.querySelector('#search-results a');
        if (firstLink) window.location.href = firstLink.href;
      }

      if (e.key === 'Tab') {
        const focusable = [...modal.querySelectorAll('button, input, a[href]')]
          .filter((el) => !el.disabled && el.offsetParent !== null);
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }

      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const links = [...document.querySelectorAll('#search-results a')];
        if (!links.length) return;
        const active = document.querySelector('#search-results a.search-active');
        let idx = active ? links.indexOf(active) : -1;
        if (active) active.classList.remove('search-active', 'bg-[#111827]');
        idx = e.key === 'ArrowDown' ? Math.min(idx + 1, links.length - 1) : Math.max(idx - 1, 0);
        links[idx].classList.add('search-active', 'bg-[#111827]');
        links[idx].scrollIntoView({ block: 'nearest' });
      }
    });

    let debounceTimer;
    input.addEventListener('input', (e) => {
      const query = e.target.value;
      if (!query) {
        clearResults(results);
        return;
      }
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        try {
          const { items, degraded } = await runSearch(query);
          renderSearchResults(results, items, { degraded });
        } catch (err) {
          // Both Pagefind and the JSON fallback failed. Without this catch the
          // rejection is swallowed inside the setTimeout async callback and the
          // user sees no feedback.
          console.warn('Search failed (Pagefind and fallback):', err);
          renderSearchError(results, staleSearchMessage(), { recoverable: true });
        }
      }, 150);
    });
  }

  // Initialize Pagefind
  async function initPagefind() {
    const { results } = getSearchElements();
    if (!results) return;

    attachInputHandlers();

    try {
      await getPagefindReady();
    } catch (e) {
      try {
        await retryPagefindReady();
      } catch (retryErr) {
        // Pagefind won't load here (corrupted/blocked assets). Don't surface an
        // error — mark it unavailable so the first query uses the JSON fallback.
        pagefindUnavailable = true;
        console.warn('Pagefind not loaded; falling back to JSON search:', retryErr);
      }
    }
  }

  initPagefind();
  document.addEventListener('astro:page-load', initPagefind);
</script>
